{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solana-smart-bot-new",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/health",
      "/version",
      "/asset-check"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "2e205fdb0eff44f78786e7500ae401a1"
    }
  ],
  "previews": {
    "kv_namespaces": [
      {
        "binding": "BOT_STATE",
        "id": "e1c54bd4247d47ebba9c1db1fa7082e0"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "PAPER_STATE_COORDINATOR",
          "class_name": "PaperStateCoordinator"
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "class_name": "MfaRateLimiter"
        }
      ]
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAPER_STATE_COORDINATOR",
        "class_name": "PaperStateCoordinator"
      },
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "MfaRateLimiter"
      }
    ]
  },
  "exports": {
    "PaperStateCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MfaRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
