{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solana-smart-bot-new",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "2e205fdb0eff44f78786e7500ae401a1"
    }
  ],
  "previews": {
    "kv_namespaces": [
      {
        "binding": "BOT_STATE",
        "id": "e1c54bd4247d47ebba9c1db1fa7082e0"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_TRADE_COORDINATOR",
        "class_name": "LiveTradeCoordinator"
      },
      {
        "name": "AUTH_GUARD",
        "class_name": "AuthGuard"
      },
      {
        "name": "PAPER_TRADING_STATE",
        "class_name": "PaperTradingState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-live-trade-coordinator",
      "new_sqlite_classes": [
        "LiveTradeCoordinator"
      ]
    },
    {
      "tag": "v2-auth-guard",
      "new_sqlite_classes": [
        "AuthGuard"
      ]
    },
    {
      "tag": "v3-paper-trading-state",
      "new_sqlite_classes": [
        "PaperTradingState"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
