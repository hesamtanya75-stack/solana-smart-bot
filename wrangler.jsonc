{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solana-smart-bot-new",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/health",
      "/version"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "f51746fea25e4b56a28bdcf2aa9b4065"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
